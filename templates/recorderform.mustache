{{!
    @template repository_cloudpoodll/recorderform

    The audio/video recorder inside the file picker's search form. The recorder page in the iframe
    fills in the hidden "s" field with the converted recording's URL and submits the form.

    Example context (json):
    {
        "iframeurl": "https://example.com/repository/cloudpoodll/recorder.php?repo_id=11&ctx_id=1",
        "width": 420,
        "height": 370,
        "title": "Record audio"
    }
}}
<div class="repo-cp-recorder">
    <input type="hidden" name="s" value="">
    <iframe class="repo-cp-recorder-frame" src="{{iframeurl}}" title="{{title}}"
        width="{{width}}" height="{{height}}" allow="camera; microphone; display-capture"></iframe>
</div>
